# Copy to .env on the server and fill in. Never commit .env.
# A long random secret. If you lose it, all stored supplier history becomes unreadable. Keep a backup somewhere safe.
YAHMI_KEY=change-me-to-a-long-random-string
# One secret access code per pilot business, as code=label pairs separated by commas (the label is only a private name for that business).
# Make each code with: openssl rand -hex 8   Give a code only to that business, privately. Without a code, visitors get the demo.
YAHMI_ACCESS_CODES=change-me-1=pilot_a,change-me-2=pilot_b
# 1 = anyone may try the demo without a code (no history, nothing saved, 10 checks per hour per address). 0 = access code required.
YAHMI_DEMO=1
